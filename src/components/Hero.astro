---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero section">
  <div class="container hero__grid">
    <!-- Left Column: Mission & Core Actions -->
    <div class="hero__content">
      <div class="hero__badge-row">
        <span class="badge badge--live">Official CNCF Chapter</span>
        <span class="badge">Peshawar, Pakistan</span>
      </div>

      <h1 class="hero__title">
        Building Peshawar's <span class="text-gradient">Cloud Native</span> Future.
      </h1>

      <p class="hero__lede">
        Hands-on Kubernetes, distributed systems, and open-source collaboration for engineers, developers, and students across Khyber Pakhtunkhwa.
      </p>

      <!-- Primary Action Buttons: upcoming events lead on every viewport -->
      <div class="hero__actions">
        <a href={`${base}/events`} class="btn btn--accent hero__action hero__action--primary">
          <span>Upcoming Events</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a
          href="https://ocgroups.dev/cncf/group/6vwk2n4"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary hero__action"
        >
          <span>Join on OCG</span>
          <span class="sr-only"> (Open Community Groups)</span>
        </a>

        <a href={`${base}/sponsors`} class="btn btn--secondary hero__action">
          <span>Sponsor Us</span>
        </a>
      </div>

      <!-- Honest Proof Note -->
      <div class="hero__proof">
        <span class="hero__proof-dot"></span>
        <p class="hero__proof-text">
          <strong>100% Free & Open Access</strong> · Powered by the Cloud Native Computing Foundation & community sponsors.
        </p>
      </div>
    </div>

    <!-- Right Column: Focus Areas & Structure -->
    <div class="hero__visual">
      <div class="terminal-card">
        <!-- Card Header (Hallmark Compliant) -->
        <div class="terminal-card__header">
          <span class="badge badge--live">CHAPTER CHARTER</span>
          <span class="terminal-card__title">cncf-peshawar.github.io</span>
        </div>

        <!-- Card Body -->
        <div class="terminal-card__body">
          <div class="charter-item">
            <span class="charter-label">COMMUNITY GROUP:</span>
            <span class="charter-val">Cloud Native Peshawar (CNCF)</span>
          </div>
          <div class="charter-item">
            <span class="charter-label">REGION:</span>
            <span class="charter-val">Peshawar, Khyber Pakhtunkhwa</span>
          </div>

          <!-- Supplementary telemetry: simplified away on narrow viewports -->
          <div class="charter-telemetry">
            <div class="charter-item">
              <span class="charter-label">PLATFORM:</span>
              <span class="charter-val">Open Community Groups (OCG)</span>
            </div>
            <div class="charter-item">
              <span class="charter-label">STATUS:</span>
              <span class="charter-val charter-val--active">
                <span class="live-dot"></span> Active CNCF Chapter
              </span>
            </div>
            <div class="charter-item">
              <span class="charter-label">FOUNDED / INAUGURAL:</span>
              <span class="charter-val">September 2026 · Peshawar</span>
            </div>

            <div class="terminal-card__divider"></div>

            <h3 class="charter-section-title">CORE TECHNICAL FOCUS</h3>
            <div class="tech-chips">
              <span class="tech-chip">Kubernetes</span>
              <span class="tech-chip">Containers</span>
              <span class="tech-chip">Microservices</span>
              <span class="tech-chip">DevOps</span>
              <span class="tech-chip">MLOps</span>
              <span class="tech-chip">Agentic AI</span>
              <span class="tech-chip">Open Source</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(var(--space-lg), 5vw, var(--space-3xl));
    padding-bottom: clamp(var(--space-xl), 6vw, var(--space-3xl));
    position: relative;
  }

  /* CNCF-style ambient blue glow (dark-first friendly) */
  .hero::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -100px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(0.56 0.18 248 / 0.18), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  /* Tablet & desktop keep the roomier presentation */
  @media (min-width: 768px) {
    .hero {
      padding-top: clamp(var(--space-xl), 6vw, var(--space-3xl));
      padding-bottom: clamp(var(--space-2xl), 8vw, var(--space-3xl));
    }

    .hero::before {
      top: -120px;
      right: -160px;
      width: 520px;
      height: 520px;
    }

    .hero__grid {
      gap: var(--space-2xl);
    }
  }

  @media (min-width: 992px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-3xl);
    }
  }

  .hero__badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .hero__title {
    font-size: clamp(1.75rem, 8.5vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
    color: var(--color-ink);
    max-width: none;
    overflow-wrap: break-word;
    word-break: normal;
    text-wrap: balance;
  }

  .hero__lede {
    font-size: clamp(var(--font-size-base), 4.4vw, var(--font-size-lg));
    line-height: var(--line-height-relaxed);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-md);
    max-width: 55ch;
    text-wrap: pretty;
  }

  .hero__actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
    margin-bottom: var(--space-md);
  }

  /* Comfortable tap targets at every width */
  .hero__action {
    width: 100%;
    min-height: 44px;
    padding-inline: var(--space-sm);
    text-align: center;
    white-space: normal;
    overflow-wrap: break-word;
  }

  @media (min-width: 768px) {
    .hero__badge-row {
      margin-bottom: var(--space-md);
    }

    .hero__title {
      font-size: var(--font-size-5xl);
      line-height: var(--line-height-tight);
      letter-spacing: -0.035em;
      margin-bottom: var(--space-md);
      max-width: 16ch;
    }

    .hero__lede {
      font-size: var(--font-size-lg);
      margin-bottom: var(--space-xl);
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      grid-template-columns: none;
      gap: var(--space-xs);
      margin-bottom: var(--space-xl);
    }

    .hero__action {
      width: auto;
      padding-inline: 1.25rem;
    }
  }

  .hero__proof {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-paper-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero__proof {
      width: fit-content;
    }
  }

  .hero__proof-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-signal-green);
    flex-shrink: 0;
  }

  .hero__proof-text {
    font-size: var(--font-size-xs);
    color: var(--color-ink-muted);
    margin: 0;
  }

  .hero__proof-text strong {
    color: var(--color-ink);
  }

  /* Terminal / Info Card Surface */
  .terminal-card {
    background-color: var(--color-paper-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .terminal-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-md);
    background-color: var(--color-paper-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .terminal-card__title {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-muted);
  }

  @media (min-width: 480px) {
    .terminal-card__title {
      display: inline;
    }
  }

  .terminal-card__body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  @media (min-width: 768px) {
    .terminal-card__body {
      padding: var(--space-lg);
    }
  }

  .charter-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 480px) {
    .charter-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .charter-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-subtle);
    letter-spacing: 0.04em;
  }

  .charter-val {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .charter-val--active {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  /* Supplementary telemetry block: keeps desktop rich, drops out on narrow screens */
  .charter-telemetry {
    display: none;
    flex-direction: column;
    gap: var(--space-xs);
  }

  @media (min-width: 768px) {
    .charter-telemetry {
      display: flex;
    }
  }

  .live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-signal-green);
    animation: pulse-live 2s infinite ease-in-out;
  }

  .terminal-card__divider {
    height: 1px;
    background: var(--gradient-brand);
    opacity: 0.4;
    margin-block: var(--space-xs);
  }

  .charter-section-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink-subtle);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-3xs);
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    padding: 0.25rem 0.6rem;
    background-color: var(--color-accent-subtle);
    border: 1px solid color-mix(in oklch, var(--color-accent) 30%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }
</style>